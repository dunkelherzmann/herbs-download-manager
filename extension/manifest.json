{
  "manifest_version": 3,
  "name": "Herb's Download Manager",
  "short_name": "Herb's DM",
  "version": "1.18",
  "description": "Hands the browser's downloads to Herb's Download Manager, and lists the videos and sounds a page plays. The browser keeps any download the app doesn't take.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "hdm@herbsdownloadmanager.org",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "naming.js",
      "background.js"
    ]
  },
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "webRequest",
    "scripting",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Herb's Download Manager",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "MacCtrl+Shift+H"
      },
      "description": "Open Herb's Download Manager's list"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
